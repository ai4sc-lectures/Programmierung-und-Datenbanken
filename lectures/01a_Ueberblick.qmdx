## Programmieren war gestern?

%%scol 62 38v
```{python}
#| echo: false
import plotly.graph_objects as go
import plotly.io as pio
from plotly.subplots import make_subplots
from ai4sc_style.plotly_loader import C, load_ai4sc_theme

load_ai4sc_theme()
CW = pio.templates["ai4sc"].layout.colorway  # Theme-Farbreihe: blau, grün, gelb, rot, ...
fig = make_subplots(rows=1, cols=3, column_widths=[0.28, 0.36, 0.36], horizontal_spacing=0.14,
                    subplot_titles=("Agenten-Nutzung", "Code-Anteil (Selbstschätzung)", "Genutzte Werkzeuge"))
panels = [
    (["täglich", "wöchentlich"], [68, 90], CW[0]),
    (["manuell", "mit KI-Hilfe", "Agent"], [27, 38, 47], CW[1]),
    (["Cursor", "Codex", "Copilot", "Claude Code"], [12, 16, 21, 39], CW[2]),
]
for i, (lab, val, col) in enumerate(panels, start=1):
    fig.add_trace(go.Bar(x=val, y=lab, orientation="h", marker_color=col,
                         text=[f"{v} %" for v in val], textposition="outside", cliponaxis=False), row=1, col=i)
    fig.update_xaxes(range=[0, 125], showticklabels=False, row=1, col=i)
    fig.update_yaxes(automargin=True, row=1, col=i)
fig.update_layout(height=420, margin=dict(l=10, r=10, t=40, b=10), showlegend=False)
fig.write_image("data/01a_Ueberblick/ki_nutzung.png", width=900, height=420, scale=2)
```

