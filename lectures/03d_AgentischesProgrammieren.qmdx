load_ai4sc_theme("pastello", themes_dir=Path("_extensions/ai4sc-style/themes"))
CW = pio.templates["ai4sc"].layout.colorway


def get_layout(title="", height=500):
    """Einheitliches Layout für alle Diagramme dieses Decks."""
    return dict(
        title=dict(text=title),
        height=height,
        margin=dict(l=50, r=50, t=80, b=50),
    )
```

## Kann KI das allein? → Die Kompetenzfalle

%%slides
%%col 50 50
### Verstehen

- [Zusammenfassen, Allgemeinwissen zu Bauen und Architektur]{.pro}
- [Kein numerisches oder räumliches Verständnis]{.con}
- [Kein Detailwissen zur Baudomäne und zu Projektinformationen]{.con}

### Generieren

- [Übersetzen, Bilder erzeugen]{.pro}
- [Halluziniert bei Unwissenheit]{.con}
- [Erzeugt keine wiederholbar zusammenhängenden Ergebnisse]{.con}

### Anpassen

- [Wissen erweiterbar (RAG), Tuning von Modellen auf Spezialwissen]{.pro}
- [Dennoch nicht an komplexe Ingenieurprobleme anpassbar]{.con}

%%sep

```{python}
#| echo: false

kategorien = ["Ethik &<br>Berufsrecht", "Wirtschaft", "Boden-<br>mechanik",
              "Hydraulik", "Statik", "Tragwerks-<br>planung"]
gpt4_2023 = [100, 85, 42, 35, 14, None]    # Pursnani et al., GPT-4
o3_2025 = [100, 100, 100, 83.3, 50, 30]    # Oblitas et al., Fig. 5

fig_pursnani = go.Figure()
for name, werte, farbe in [("2023: GPT-4", gpt4_2023, CW[4]),
                           ("2025: ChatGPT o3", o3_2025, CW[0])]:
    fig_pursnani.add_bar(
        x=kategorien, y=werte, name=name, marker_color=farbe,
        text=["" if v is None else f"{v:.0f}%" for v in werte],
        textposition="outside")
fig_pursnani.add_hline(y=70, line_dash="dash", line_color=CW[4],
                       annotation_text="Gut", annotation_position="left")
fig_pursnani.update_layout(
    **get_layout("LLMs in der Ingenieur-Grundlagenprüfung (FE)", height=450),
    barmode="group", xaxis=dict(automargin=True),
    yaxis=dict(range=[0, 118], ticksuffix="%", automargin=True),
    legend=dict(orientation="h", y=1.02, x=0))
fig_pursnani.write_image("data/03d_AgentischesProgrammieren/kompetenzfalle.png", width=700, height=450, scale=2)
fig = fig_pursnani
```

%%cache_plotly "data/03d_AgentischesProgrammieren/kompetenzfalle.json" 700x450 write

[Daten: @PURSNANI2023100183, @fe_civil_2025. Statik und Tragwerke bleiben am schwächsten.]{style="font-size: 0.7em"}
%%/col

%%slide_ref @PURSNANI2023100183 Pursnani et al.: _Performance of ChatGPT on the US fundamentals of engineering exam_, **Computers and Education: AI**, 2023.
%%slide_ref @fe_civil_2025 Oblitas, Adeeb & Cruz-Noguez: _Performance of AI Chatbots on the Fundamentals of Engineering Civil Exam_, **Discover Artificial Intelligence**, 2025.
%%/slides

%%book
Wie gut lösen Sprachmodelle Ingenieuraufgaben, wenn wir sie allein arbeiten lassen? Die Antwort hängt davon ab, welche Fähigkeit gefragt ist. Beim Verstehen sind sie stark im Zusammenfassen und im Allgemeinwissen zu Bauen und Architektur; ihnen fehlen jedoch numerisches und räumliches Verständnis sowie Detailwissen zur Baudomäne und zum konkreten Projekt. Beim Generieren übersetzen sie zuverlässig und erzeugen Bilder, halluzinieren aber bei Unwissenheit und liefern keine wiederholbar zusammenhängenden Ergebnisse. Ihr Wissen lässt sich durch Retrieval-Augmented Generation (RAG) erweitern oder durch Nachtraining auf Spezialwissen abstimmen, an komplexe Ingenieurprobleme lassen sie sich damit aber dennoch nicht anpassen.

![LLMs in der Ingenieur-Grundlagenprüfung (FE), Anteil richtig gelöster Aufgaben je Fachgebiet [@PURSNANI2023100183; @fe_civil_2025]](data/03d_AgentischesProgrammieren/kompetenzfalle.png){fig-align="center" width="85%"}

Das Diagramm zeigt diese Grenzen anhand der US-amerikanischen Ingenieur-Grundlagenprüfung (Fundamentals of Engineering, FE). Auf der x-Achse stehen die Fachgebiete, auf der y-Achse der Anteil richtig gelöster Aufgaben, und die gestrichelte Linie bei 70 Prozent markiert ein gutes Ergebnis. GPT-4 erreichte 2023 in Ethik und Berufsrecht 100 Prozent und in Wirtschaft 85 Prozent, in Bodenmechanik, Hydraulik und Statik dagegen nur 42, 35 und 14 Prozent [@PURSNANI2023100183]. Das neuere Modell ChatGPT o3 verbesserte sich 2025 deutlich, blieb aber in der Statik bei 50 und in der Tragwerksplanung bei 30 Prozent [@fe_civil_2025]. Gerade die Gebiete, die unser Beispiel betrifft, bleiben also die schwächsten. Wir sprechen von einer Kompetenzfalle, weil die sprachliche Gewandtheit des Modells eine fachliche Kompetenz nahelegt, die es in diesen Gebieten nicht besitzt.
%%/book


# Agentisches Programmieren

