               tickvals=[1e3, 1e6, 1e9, 1e12], ticktext=["1 KB", "1 MB", "1 GB", "1 TB"]),
    yaxis=dict(type="log", title="Zugriffszeit", range=[-1, 8.6], automargin=True,
               showline=True, linecolor=CW[4], linewidth=2, ticks="outside", showgrid=True,
               tickvals=[1, 1e2, 1e4, 1e6], ticktext=["1 ns", "100 ns", "10 µs", "1 ms"]))
