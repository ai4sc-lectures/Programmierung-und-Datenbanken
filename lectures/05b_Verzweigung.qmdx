| ![Braun & Plastik](images/05a_Operatoren/stuhl_plastik_braun.svg){.nostretch height="48px"} | ![Falsch](images/05a_Operatoren/falsch_kreuz.svg){.nostretch height="30px"}<br>[Falsch (0)]{style="font-size:0.7em"} | ![Wahr](images/05a_Operatoren/wahr_haken.svg){.nostretch height="30px"}<br>[Wahr (1)]{style="font-size:0.7em"} | ![Falsch](images/05a_Operatoren/falsch_kreuz.svg){.nostretch height="30px"}<br>[Falsch (0)]{style="font-size:0.7em"} | ![Falsch](images/05a_Operatoren/falsch_kreuz.svg){.nostretch height="30px"}<br>[Falsch (0)]{style="font-size:0.7em"} | ![Nein](images/05a_Operatoren/stuhl_plastik_braun_no.svg){.nostretch height="48px"} |
